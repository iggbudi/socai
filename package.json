{
  "name": "socai-my-id",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js app for socai.my.id",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "bot": "node telegram-bot.js",
    "dev": "node server.js & node telegram-bot.js",
    "test": "node --test \"test/**/*.test.js\" \"lib/shared/**/*.test.js\" \"lib/features/**/*.test.js\" \"lib/web/**/*.test.js\"",
    "test:ci": "npm test && QA_SKIP_HTTP=1 node test/qa-smoke.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=41 --test-coverage-functions=57 --test-coverage-branches=68 --test-coverage-exclude=\"lib/features/telegram/commands.js\" \"test/**/*.test.js\" \"lib/shared/**/*.test.js\" \"lib/features/**/*.test.js\" \"lib/web/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "node-pg-migrate -f migrations.config.js -j js -m migrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down 1",
    "eval:export": "node scripts/export-evaluation.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "telegraf": "^4.16.3",
    "typebox": "^1.1.38"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6"
  }
}
